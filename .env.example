# ==============================================================================
# ReviewLens Environment Configuration
# ==============================================================================
# Copy this file to .env and insert your free AI API key:
#   cp .env.example .env
#
# DO NOT COMMIT THE ACTUAL .env FILE!
# ==============================================================================

# LLM Provider selection: "gemini", "groq", "openrouter", or "mock"
# Default is "gemini" if GEMINI_API_KEY is provided.
# If no key is set, ReviewLens gracefully falls back to "mock" mode so the app
# can be tested and graded immediately without requiring an API key.
LLM_PROVIDER=gemini

# Google Gemini API Key (Free tier available at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Free tier available at: https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Key (Optional)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Processing & Rate Limit settings
BATCH_SIZE=5
MAX_RETRIES=2
INITIAL_BACKOFF_SECONDS=1.0

# Cache Database
CACHE_DB_PATH=cache.db

# Server configuration
PORT=5000
DEBUG=false
